      "inventory": [],
      "cases": [
        {
          "id": "normal_finish",
          "setup": "reset_before_case",
          "regions": [
            {"role": "floor", "min": [-5, -61, -5], "max": [10, -61, 6], "material": "stone"},
            {"role": "air", "min": [-5, -60, -5], "max": [10, -54, 6], "material": "air"},
            {"role": "support", "min": [2, -60, 0], "max": [2, -60, 0], "material": "stone"},
            {"role": "target", "min": [2, -59, 0], "max": [2, -59, 0], "material": "dirt"}
          ],
          "target_material": "dirt",
          "action_offset_ms": 1100,
          "observation_ms": 9000,
