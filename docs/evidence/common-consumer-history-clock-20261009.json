  "scope": "Official loopback servers: common entity history read clock, frozen samples, empty pages, world change and revocation; no new game feature.",
  "driver_source": "import argparse\nimport hashlib\nimport json\nimport pathlib\nimport subprocess\nimport sys\nimport time\n\nrepo = pathlib.Path('/workspace/Voxrig')\nsys.path.insert(0, str(repo / 'scripts'))\nimport run_climbing_control as live\nimport run_entity_history as history\n\n\ndef ns(duration):\n    return duration['secs'] * 1_000_000_000 + duration['nanos']\n\n\ndef check(version, command, request, trace, report):\n    def ask(action, **arguments):\n        result = request(action, **arguments)\n        assert result['ok'], result\n        return result['result']\n\n    first = ask('history')\n    assert first['records']\n    sample = first['records'][0]\n    time.sleep(0.15)\n    second = ask('history')\n    retained = next(r for r in second['records'] if r['ordinal'] == sample['ordinal'])\n    assert retained == sample\n    first_age = ns(first['captured_after']) - ns(sample['applied_after'])\n    second_age = ns(second['captured_after']) - ns(sample['applied_after'])\n    assert first_age >= 0 and second_age >= first_age + 100_000_000\n    report['checks'].append(dict(name='quiet_read_advances_age_without_retiming_sample',\n                                sample=sample, first_clock=first['captured_after'],\n                                second_clock=second['captured_after'],\n                                first_age_ns=first_age, second_age_ns=second_age))\n    ask('history_tail', maximum=1)\n    empty = ask('history', resume=True, maximum=1)\n    assert not empty['records'] and not empty['has_more']\n    assert ns(empty['captured_after']) >= ns(second['captured_after'])\n    report['checks'].append(dict(name='empty_page_retains_read_clock', page=empty))\n\n    history.check(version, command, request, trace, report)\n    pages = [entry['page'] for entry in report['checks'] if 'page' in entry]\n    clocks = [ns(page['captured_after']) for page in pages]\n    assert clocks == sorted(clocks)\n    assert all(ns(page['captured_after']) >= ns(record['applied_after'])\n               for page in pages for record in page['records'])\n    report['checks'].append(dict(name='world_change_and_revocation_preserve_same_clock',\n                                page_clocks_ns=clocks))\n\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--accept-eula', action='store_true', required=True)\nparser.parse_args()\nbinary = pathlib.Path('/workspace/.voxrig-env/climbing-target/debug/examples/migration_api_probe')\njars = repo / '.local/climbing/downloads'\nsdk_commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo, text=True).strip()\nsdk_src_tree = subprocess.check_output(['git', 'rev-parse', 'HEAD:src'], cwd=repo, text=True).strip()\nruns = []\nfor version in ['1.16.1', '1.21.11']:\n    before = set(live.ROOT.iterdir())\n    live.run(version, binary, jars, check=check, server_properties={'view-distance': 6})\n    folders = set(live.ROOT.iterdir()) - before\n    assert len(folders) == 1\n    folder = folders.pop()\n    report = json.loads((folder / 'report.json').read_text())\n    assert report['passed'] and not report['trace_errors']\n    runs.append(dict(version=version, folder=str(folder), report=report,\n                     report_sha256=hashlib.sha256((folder / 'report.json').read_bytes()).hexdigest(),\n                     packets_sha256=hashlib.sha256((folder / 'packets.jsonl').read_bytes()).hexdigest(),\n                     official_jar_sha1=hashlib.sha1((jars / (version+'-server.jar')).read_bytes()).hexdigest()))\nproof = dict(sdk_commit=sdk_commit, sdk_src_tree=sdk_src_tree,\n             probe_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),\n             driver_sha256=hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),\n             runs=runs)\npath = pathlib.Path('/tmp/voxrig-consumer-history-clock-20261009.json')\npath.write_text(json.dumps(proof, indent=2)+'\\n')\nprint(json.dumps(dict(proof=str(path), checks=[len(r['report']['checks']) for r in runs])))\n",
